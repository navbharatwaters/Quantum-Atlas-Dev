# Quantum Atlas — environment variables
# Copy to .env.local for local development.
# NEVER commit .env.local to git.

# ---------------------------------------------------------------------------
# OpenRouter (replaces OpenAI for both chat API and voice agent)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=          # Required. Get from https://openrouter.ai/keys
LLM_MODEL=                   # Optional. Defaults to google/gemini-2.5-flash

# ---------------------------------------------------------------------------
# LiveKit (voice agent)
# ---------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# Deepgram (voice agent STT/TTS)
# ---------------------------------------------------------------------------
DEEPGRAM_API_KEY=

# ---------------------------------------------------------------------------
# Payload CMS
# ---------------------------------------------------------------------------
PAYLOAD_SECRET=            # Required. 48+ random characters, no fallback
DATABASE_URI=              # Required. PostgreSQL connection string
MEDIA_DIR=                 # Optional. Absolute upload folder (default ./media)

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ---------------------------------------------------------------------------
# No longer needed (removed)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY       — replaced by OPENROUTER_API_KEY
# OPENAI_ASSISTANT_ID  — replaced by static system prompt
# RAG_API_URL          — removed; KB is now embedded in system prompt
# RAG_API_KEY          — removed
# NEXT_PUBLIC_SALES_PHONE — removed; phone numbers are hardcoded constants
